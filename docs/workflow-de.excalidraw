   "versionNonce": 1526953264,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "version": 1,
   "text": "Wird nur auf dem Hauptzweig geschrieben und gepusht. Kein Feature-Branch fasst diese Datei an: ein Anspruch aus dem Worktree\nist unsichtbar, bis das Feature merged, und die nächste Sitzung nimmt sich ein Feature, das längst vergeben ist.",
   "originalText": "Wird nur auf dem Hauptzweig geschrieben und gepusht. Kein Feature-Branch fasst diese Datei an: ein Anspruch aus dem Worktree\nist unsichtbar, bis das Feature merged, und die nächste Sitzung nimmt sich ein Feature, das längst vergeben ist.",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 15
  },
