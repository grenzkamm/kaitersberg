   "link": null,
   "locked": false,
   "version": 1,
   "text": "Stufen bewegen sich nur vorwärts. Die drei um den Bau herum gehören dem Menschen, weil der Bau ihm gehört.",
   "originalText": "Stufen bewegen sich nur vorwärts. Die drei um den Bau herum gehören dem Menschen, weil der Bau ihm gehört.",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 15
  },
  {
   "id": "te196",
   "type": "text",
   "x": 80,
   "y": 2056,
   "width": 967.2,
   "height": 37.5,
   "angle": 0,
   "strokeColor": "#c92a2a",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
